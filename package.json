{
  "name": "english-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "אפליקציית ווב ללימוד אנגלית לדוברי עברית – דיבור, הבנת הנשמע ואוצר מילים",
  "scripts": {
    "dev": "node --watch server/index.js & vite",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test test/*.test.js",
    "build:trial": "vite build -c vite.artifact.config.js && node artifact/package-page.mjs"
  },
  "engines": {
    "node": ">=22.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "express": "^4.22.3",
    "nodemailer": "^10.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.10.3",
    "vite": "^8.3.6",
    "vite-plugin-singlefile": "^2.3.4"
  }
}
