# העתיקו לקובץ .env או הגדירו כמשתני סביבה. כל המפתחות נשמרים בצד השרת בלבד.

# --- מורה AI (Claude). בלי מפתח: מצב הדגמה מסומן ---
ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5-5      # ברירת מחדל. זול בהרבה: claude-haiku-5-5
# CLAUDE_EFFORT=low                 # low מתאים לשיחה בזמן אמת

# --- קול איכותי בשרת (OpenAI TTS + תמלול). בלי מפתח: קול וזיהוי דיבור של הדפדפן ---
OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_STT_MODEL=gpt-4o-mini-transcribe

# --- מייל לאיפוס סיסמה (SMTP). בלי הגדרה: הקישור נכתב ללוג השרת ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="English Coach <no-reply@example.com>"
APP_URL=http://localhost:3000

# --- כללי ---
PORT=3000
# DB_PATH=./data/app.db
# NODE_ENV=production   # חובה בייצור: עוגיות Secure ובלי חשיפת קישורי איפוס
